DEFINE QLOCAL('BANKA.PAYMENT.REQUEST') DEFPSIST(NO) REPLACE
DEFINE QLOCAL('BANKB.PAYMENT.REQUEST') DEFPSIST(NO) REPLACE
DEFINE QLOCAL('PAYMENT.LOG.EVENTS') DEFPSIST(NO) REPLACE

DEFINE QLOCAL('BANKA.PAYMENT.BACKOUT') DEFPSIST(NO) REPLACE
DEFINE QLOCAL('BANKB.PAYMENT.BACKOUT') DEFPSIST(NO) REPLACE
DEFINE QLOCAL('PAYMENT.LOG.BACKOUT') DEFPSIST(NO) REPLACE
DEFINE QLOCAL('IPN.DEAD.LETTER.QUEUE') DEFPSIST(NO) REPLACE

ALTER QMGR DEADQ('IPN.DEAD.LETTER.QUEUE')

ALTER QLOCAL('BANKA.PAYMENT.REQUEST') BOTHRESH(3) BOQNAME('BANKA.PAYMENT.BACKOUT')
ALTER QLOCAL('BANKB.PAYMENT.REQUEST') BOTHRESH(3) BOQNAME('BANKB.PAYMENT.BACKOUT')
ALTER QLOCAL('PAYMENT.LOG.EVENTS') BOTHRESH(3) BOQNAME('PAYMENT.LOG.BACKOUT')

DISPLAY QLOCAL('BANKA.PAYMENT.REQUEST') BOTHRESH BOQNAME CURDEPTH
DISPLAY QLOCAL('BANKB.PAYMENT.REQUEST') BOTHRESH BOQNAME CURDEPTH
DISPLAY QLOCAL('PAYMENT.LOG.EVENTS') BOTHRESH BOQNAME CURDEPTH
DISPLAY QLOCAL('BANKA.PAYMENT.BACKOUT') CURDEPTH
DISPLAY QLOCAL('BANKB.PAYMENT.BACKOUT') CURDEPTH
DISPLAY QLOCAL('PAYMENT.LOG.BACKOUT') CURDEPTH
DISPLAY QLOCAL('IPN.DEAD.LETTER.QUEUE') CURDEPTH
DISPLAY QMGR DEADQ
