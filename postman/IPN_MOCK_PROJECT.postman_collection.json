          "raw": "{\n  \"sourceAccount\": \"A001\",\n  \"destinationBank\": \"BANKB\",\n  \"destinationAccount\": \"B001\",\n  \"amount\": 1,\n  \"currency\": \"EGP\",\n  \"idempotencyKey\": \"IDEMP-FINAL-001\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{base_url}}/api/v1/payments",
          "host": [
            "{{base_url}}"
          ],
          "path": []
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"Duplicate returned\", function () { var j = pm.response.json(); pm.expect(j.duplicate).to.eql(true); pm.expect(j.continueProcessing).to.eql(false); });"
            ]
          }
        }
      ]
    },
