          "raw": "{\n  \"sourceAccount\": \"A001\",\n  \"destinationBank\": \"BANKB\",\n  \"destinationAccount\": \"B001\",\n  \"amount\": 2,\n  \"currency\": \"EGP\",\n  \"idempotencyKey\": \"IDEMP-FINAL-001\"\n}",
          "options": {
